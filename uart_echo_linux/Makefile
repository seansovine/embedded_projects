.PHONY: configure build run clean

clean:
	rm -rf build/*

configure:
	cmake -S . -B build

build:
	cmake --build build

run:
	build/uart-client

# NOTE: The above let us build without using the VS Code extension,
#       relying only on the CMake project generated by CubeMX.
#
